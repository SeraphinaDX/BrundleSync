<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
    <RadioGroup android:id="@+id/page_navigation" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <RadioButton android:id="@+id/nav_status" android:text="Status" style="@style/PageTab" android:button="@null" android:gravity="center" android:minHeight="48dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
        <RadioButton android:id="@+id/nav_activity" android:text="Activity" style="@style/PageTab" android:button="@null" android:gravity="center" android:minHeight="48dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
        <RadioButton android:id="@+id/nav_settings" android:text="Settings" style="@style/PageTab" android:button="@null" android:gravity="center" android:minHeight="48dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
    </RadioGroup>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:id="@+id/status_page" android:visibility="gone" android:fillViewport="true" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:id="@+id/setup_status" android:text="Setup needed" android:textSize="26sp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/setup_summary" android:text="Scan a desktop QR code in Settings, then choose your camera folder." android:textSize="16sp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/work_status" android:text="No backup queued" android:textSize="20sp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <ProgressBar android:id="@+id/backup_progress" style="?android:attr/progressBarStyleHorizontal" android:indeterminate="true" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/status" android:text="No backup activity yet." android:textSize="16sp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/backup_counts" android:text="" android:textSize="16sp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/last_backup" android:text="No completed backup check yet." android:textSize="16sp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/constraints" android:text="" android:textSize="16sp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Button android:id="@+id/backup_now" android:text="@string/backup_now" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                
        
                <Button android:id="@+id/stop" android:text="@string/stop" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                
        
                <Button android:id="@+id/recheck" android:text="@string/recheck" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                
        
                <Button android:id="@+id/open_settings" android:text="Open settings" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/activity_page" android:visibility="gone" android:fillViewport="true" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:id="@+id/activity_heading" android:text="Recent activity" android:textSize="26sp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/activity_help" android:text="The latest 100 events stay on this phone. Clearing this list does not clear backup receipts." android:textSize="16sp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Button android:id="@+id/clear_activity" android:text="Clear activity" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/activity_log" android:text="No backup activity yet." android:textSize="16sp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/settings_page" android:visibility="visible" android:fillViewport="true" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:id="@+id/settings_heading" android:text="Set up camera backup" android:textSize="26sp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/setup_steps" android:text="1. Scan your desktop QR code 2. Choose your camera folder 3. Save and start backup" android:textSize="16sp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Button android:id="@+id/scan_setup" android:text="Scan desktop QR" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <Button android:id="@+id/manual_settings" android:text="Manual connection settings" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <LinearLayout android:id="@+id/connection_fields" android:visibility="gone" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <EditText android:id="@+id/device_id" android:hint="@string/device_id" android:singleLine="true" android:inputType="textVisiblePassword" android:importantForAutofill="no" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    
        
                    <EditText android:id="@+id/discovery_url" android:hint="@string/discovery_url" android:singleLine="true" android:inputType="textUri" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    
        
                    <EditText android:id="@+id/discovery_token" android:hint="@string/discovery_token" android:singleLine="true" android:inputType="textPassword" android:importantForAutofill="no" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    
        
                    <EditText android:id="@+id/folder_id" android:hint="@string/folder_id" android:singleLine="true" android:inputType="textVisiblePassword" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    
        
                    <EditText android:id="@+id/folder_secret" android:hint="@string/folder_secret" android:singleLine="true" android:inputType="textPassword" android:importantForAutofill="no" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    
        
                </LinearLayout>
                <Button android:id="@+id/choose_folder" android:text="@string/choose_folder" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                
        
                <TextView android:id="@+id/source_folder" android:text="@string/no_folder" android:textIsSelectable="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                
        
                <CheckBox android:id="@+id/automatic" android:text="@string/automatic" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                
        
                <CheckBox android:id="@+id/unmetered" android:text="@string/unmetered" android:checked="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                
        
                <CheckBox android:id="@+id/charging" android:text="@string/charging" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                
        
                <Button android:id="@+id/save" android:text="Save &amp; start backup" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/settings_message" android:text="" android:textSize="16sp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/privacy_help" android:text="The QR contains reusable access credentials. Only scan a code from your own desktop. Your original camera files are never deleted." android:textSize="16sp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
